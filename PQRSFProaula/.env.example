# Copia este archivo como ".env" en la raíz del proyecto (PQRSFProaula) y pon tus valores.
# VS Code lo carga solo (ver .vscode/launch.json -> envFile).
# NO subas el .env a GitHub.
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-client-secret
JWT_SECRET=una-clave-larga-de-al-menos-32-caracteres-solo-tuya

# Dominio con el que se publica la app (debe apuntar a la IP del servidor).
# Ejemplo: pqrsf.midominio.com
DOMINIO=pqrsf.midominio.com
